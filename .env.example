# ============================================================
# Server-side keys (never exposed to browser)
# ============================================================

# Google Gemini — LLM generation + embeddings (FREE tier available)
GEMINI_API_KEY=your_google_gemini_api_key_here

# ElevenLabs — used server-side for TTS proxy
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ============================================================
# Client-side keys (accessible in browser via VITE_ prefix)
# ============================================================

# ElevenLabs publishable key — for browser-side STT/TTS WebSocket
# This is safe to expose; ElevenLabs keys are usage-limited
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs Voice ID — default multilingual voice
VITE_ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
